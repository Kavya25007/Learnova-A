# ─── Smart Lecture Notes — Frontend (Vite) Environment Variables ─────────────
#
# Copy this file to .env and fill in your values.
# Vite automatically reads .env files in the same directory.

# ─── Required ─────────────────────────────────────────────────────────────────

# Port for the Vite dev server
PORT=8081

# URL base path for the frontend (use / for local development)
BASE_PATH=/

# ─── Optional ─────────────────────────────────────────────────────────────────

# API server URL — Vite will proxy /api/* requests to this target in dev mode.
# Only needed if your API server runs on a different port.
# Default: http://localhost:8080
# API_PROXY_TARGET=http://localhost:8080
