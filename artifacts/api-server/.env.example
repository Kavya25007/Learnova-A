# ─── Smart Lecture Notes — API Server Environment Variables ──────────────────
#
# Copy this file to .env and fill in your values.
# The server reads these automatically when started.
#
# NOTE: Never commit .env to git — it contains your secret API key.

# ─── Required ─────────────────────────────────────────────────────────────────

# Port for the API server to listen on
PORT=8080

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ─── Optional ─────────────────────────────────────────────────────────────────

# OpenAI model to use for note generation and the assistant chat.
# Default: gpt-4o  (recommended — fast, accurate, widely available)
# Other options: gpt-4o-mini (cheaper), gpt-4-turbo, o1-mini
# OPENAI_MODEL=gpt-4o

# ─── Replit-Only (DO NOT set these locally) ───────────────────────────────────
# These are only used when running inside the Replit AI Integrations environment.
# AI_INTEGRATIONS_OPENAI_BASE_URL=
# AI_INTEGRATIONS_OPENAI_API_KEY=
